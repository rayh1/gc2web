---
// The "born on this day" block on the homepage.
//
// The site is statically built, so the day cannot be resolved at build time without a
// daily rebuild. Instead the whole year's index is inlined here and the visitor's own
// browser picks today's key out of it — which also makes the date the visitor's local
// date rather than a fixed Europe/Amsterdam or UTC one ([R-1]).
//
// The index is generated by `gen_site/birthday_index.py`; withheld individuals are
// filtered out before it is written, never here at render time (constitution [C-1]).
import birthdayIndex from "../data/birthday-index.json";

const HEADING = "Geboren op deze dag";
// Rendered server-side, so it is what a visitor without JavaScript is left with ([R-5]).
const NO_JS_MESSAGE =
  "Deze lijst wordt in je browser samengesteld. Zet JavaScript aan om te zien wie er vandaag geboren is.";

// Escaped so a name can never close the script element early.
const serializedIndex = JSON.stringify(birthdayIndex).replace(/</g, "\\u003c");
---

<section
  id="birthday-block"
  class="not-prose mt-10 rounded-[1.5rem] border border-archive-line bg-archive-paper p-6 dark:border-archive-dark-line dark:bg-archive-dark-paper"
>
  <h2 class="font-display text-2xl font-semibold text-archive-ink dark:text-archive-dark-ink">
    {HEADING}
  </h2>
  <div id="birthday-block-content" class="mt-3 text-archive-muted dark:text-archive-dark-muted">
    <p>{NO_JS_MESSAGE}</p>
  </div>
</section>

<script
  type="application/json"
  id="birthday-index-data"
  is:inline
  set:html={serializedIndex}
/>

<script is:inline>
  (function () {
    var container = document.getElementById("birthday-block-content");
    var payload = document.getElementById("birthday-index-data");
    if (!container || !payload) return;

    var index;
    try {
      index = JSON.parse(payload.textContent || "{}");
    } catch (error) {
      // Leave the server-rendered message standing rather than showing a broken block.
      return;
    }

    var now = new Date();
    var key =
      String(now.getMonth() + 1).padStart(2, "0") +
      "-" +
      String(now.getDate()).padStart(2, "0");
    var entries = index[key] || [];

    container.textContent = "";

    if (entries.length === 0) {
      var empty = document.createElement("p");
      empty.textContent = "Vandaag is er niemand uit deze stamboom geboren.";
      container.appendChild(empty);
      return;
    }

    var list = document.createElement("ul");
    list.className = "space-y-1";
    entries.forEach(function (entry) {
      var item = document.createElement("li");
      var link = document.createElement("a");
      link.href = "/entity/" + String(entry.id).toLowerCase() + "/";
      link.textContent = entry.name;
      link.className =
        "font-medium text-archive-accent hover:text-archive-ink dark:text-archive-dark-accent dark:hover:text-archive-dark-ink";
      item.appendChild(link);
      item.appendChild(document.createTextNode(" " + entry.lifespan));
      list.appendChild(item);
    });
    container.appendChild(list);
  })();
</script>
